{
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "bash tools/vercel-ignore.sh",
  "redirects": [
    {
      "source": "/bowman-bangers-2025",
      "destination": "/bowman-bangers",
      "permanent": true
    },
    {
      "source": "/cooperflag",
      "destination": "/cooper-flagg-rookie-cards",
      "permanent": true
    },
    {
      "source": "/card-umbreon-ex-sir-pe",
      "destination": "/prismatic-evolutions-guide",
      "permanent": true
    },
    {
      "source": "/card-mega-darkrai-ex-sir",
      "destination": "/pitch-black-set-guide",
      "permanent": true
    },
    {
      "source": "/card-mega-greninja-ex-sir",
      "destination": "/chaos-rising",
      "permanent": true
    },
    {
      "source": "/card-tr-mewtwo-ex-sir",
      "destination": "/ascended-heroes",
      "permanent": true
    },
    {
      "source": "/card-mega-lucario-ex-sir",
      "destination": "/ascended-heroes",
      "permanent": true
    },
    {
      "source": "/card-mewtwo-ex-sir-th26",
      "destination": "/pokemon-30th-anniversary-2026",
      "permanent": true
    },
    {
      "source": "/card-mew-ex-sir-th26",
      "destination": "/pokemon-30th-anniversary-2026",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/research",
      "permanent": true
    },
    {
      "source": "/set-index-preview",
      "destination": "/indices",
      "permanent": true
    },
    {
      "source": "/shohei-ohtani-cards",
      "destination": "/mlb-cards#shohei-ohtani",
      "permanent": true
    },
    {
      "source": "/munetaka-murakami-rookie-cards",
      "destination": "/mlb-cards#munetaka-murakami",
      "permanent": true
    },
    {
      "source": "/aiva-arquette-1st-bowman",
      "destination": "/mlb-cards#aiva-arquette",
      "permanent": true
    },
    {
      "source": "/ethan-holliday-rookie-cards",
      "destination": "/mlb-cards#ethan-holliday",
      "permanent": true
    },
    {
      "source": "/roman-anthony-rookie-cards",
      "destination": "/mlb-cards#roman-anthony",
      "permanent": true
    },
    {
      "source": "/jacob-misiorowski-rookie-cards",
      "destination": "/mlb-cards#jacob-misiorowski",
      "permanent": true
    },
    {
      "source": "/pete-crow-armstrong-cards",
      "destination": "/mlb-cards#pete-crow-armstrong",
      "permanent": true
    },
    {
      "source": "/adley-rutschman-cards",
      "destination": "/mlb-cards#adley-rutschman",
      "permanent": true
    },
    {
      "source": "/chase-delauter-rookie-cards",
      "destination": "/mlb-cards#chase-delauter",
      "permanent": true
    },
    {
      "source": "/best-baseball-cards-under-50",
      "destination": "/mlb-cards",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/feed/:file",
      "destination": "/data/feed/:file"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)\\.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/badge/(.*)\\.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/fonts/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
