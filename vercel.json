{
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "bash tools/vercel-ignore.sh",
  "redirects": [
    {
      "source": "/bowman-bangers-2025",
      "destination": "/bowman-bangers",
      "permanent": true
    },
    {
      "source": "/cooperflag",
      "destination": "/cooper-flagg-rookie-cards",
      "permanent": true
    },
    {
      "source": "/card-ethan-holliday",
      "destination": "/ethan-holliday-rookie-cards",
      "permanent": true
    },
    {
      "source": "/card-aiva-arquette",
      "destination": "/aiva-arquette-1st-bowman",
      "permanent": true
    },
    {
      "source": "/card-umbreon-ex-sir-pe",
      "destination": "/prismatic-evolutions-guide",
      "permanent": true
    },
    {
      "source": "/card-mega-darkrai-ex-sir",
      "destination": "/pitch-black-set-guide",
      "permanent": true
    },
    {
      "source": "/card-mega-greninja-ex-sir",
      "destination": "/chaos-rising",
      "permanent": true
    },
    {
      "source": "/card-tr-mewtwo-ex-sir",
      "destination": "/ascended-heroes",
      "permanent": true
    },
    {
      "source": "/card-mega-lucario-ex-sir",
      "destination": "/ascended-heroes",
      "permanent": true
    },
    {
      "source": "/card-ethan-holliday-sapphire",
      "destination": "/ethan-holliday-rookie-cards",
      "permanent": true
    },
    {
      "source": "/card-roman-anthony-sapphire",
      "destination": "/roman-anthony-rookie-cards",
      "permanent": true
    },
    {
      "source": "/card-mewtwo-ex-sir-th26",
      "destination": "/pokemon-30th-anniversary-2026",
      "permanent": true
    },
    {
      "source": "/card-mew-ex-sir-th26",
      "destination": "/pokemon-30th-anniversary-2026",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/research",
      "permanent": true
    },
    {
      "source": "/set-index-preview",
      "destination": "/indices",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/feed/:file",
      "destination": "/data/feed/:file"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)\\.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/fonts/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
